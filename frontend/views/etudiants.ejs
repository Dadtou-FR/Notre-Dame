<%- include('partials/header', { title: 'Liste des étudiants' }) %>

<!-- Success Messages -->
<% if (success && success !== '') { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="fas fa-check-circle me-2"></i>
    <% if (success === 'created') { %>
      Étudiant ajouté avec succès !
    <% } else if (success === 'updated') { %>
      Étudiant mis à jour avec succès !
    <% } else if (success === 'deleted') { %>
      Étudiant supprimé avec succès !
    <% } else { %>
      Donnée ajoutée avec succès !
    <% } %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
  </div>
<% } %>

<% const totalEtudiants = (etudiants || []).length; const vaccinated = (etudiants || []).filter(e => e.est_vaccine).length; %>
<div class="row g-3 mb-4 dashboard-tiles">
  <div class="col-6 col-sm-4 col-md-3">
    <div class="tile stats-card blue text-center">
      <div>
        <div class="stat-value h4 mb-0"><%= totalEtudiants %></div>
        <small class="text-muted">Total étudiants</small>
      </div>
    </div>
  </div>
  <div class="col-6 col-sm-4 col-md-3">
    <div class="tile stats-card green text-center">
      <div>
        <div class="stat-value h4 mb-0"><%= vaccinated %></div>
        <small class="text-muted">Vaccinés</small>
      </div>
    </div>
  </div>
</div>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
  <h2 class="h4 mb-0 slide-in-left">Étudiants</h2>
  <div class="d-flex flex-wrap gap-2">
    <div class="input-group">
      <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
      <input id="search-etudiants" type="text" class="form-control" placeholder="Rechercher (nom, matricule, classe...)" />
    </div>
    <button type="button" class="btn btn-outline-secondary btn-modern no-print" onclick="window.print()" title="Imprimer la liste filtrée">
      <i class="fas fa-print me-2"></i>Imprimer
    </button>
    <button type="button" class="btn btn-outline-primary btn-modern" onclick="window.AppTables?.exportToCSV('table-etudiants','etudiants.csv')">
      <i class="fas fa-file-export me-2"></i>Exporter CSV
    </button>
    <a href="/etudiants/add" class="btn btn-primary btn-modern slide-in-right hover-lift"><i class="fas fa-user-plus me-2"></i>Ajouter un étudiant</a>
  </div>
</div>

<!-- Formulaire de filtrage -->
<form method="GET" action="/etudiants" class="row g-3 mb-4 p-3 bg-light rounded">
  <div class="col-md-4">
    <label for="classe" class="form-label">Filtrer par classe</label>
    <select name="classe" id="classe" class="form-select">
      <option value="">Toutes les classes</option>
      <% (classes || []).forEach(function(c){ %>
        <option value="<%= c %>" <%= (filters && filters.classe === c) ? 'selected' : '' %>><%= c %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-md-4">
    <label for="telephone_parent" class="form-label">Filtrer par téléphone parent</label>
    <input type="text" name="telephone_parent" id="telephone_parent" class="form-control" placeholder="Numéro de téléphone" value="<%= (filters && filters.telephone_parent) || '' %>">
  </div>
  <div class="col-md-4 d-flex align-items-end gap-2">
    <button type="submit" class="btn btn-primary">
      <i class="fas fa-filter me-1"></i>Filtrer
    </button>
    <a href="/etudiants" class="btn btn-outline-secondary">
      <i class="fas fa-times me-1"></i>Effacer les filtres
    </a>
  </div>
</form>

<!-- Section d'affichage des filtres appliqués - VISIBLE À L'ÉCRAN ET EN IMPRESSION -->
<% 
  let hasFilters = (filters && (filters.classe || filters.telephone_parent));
%>
<% if (hasFilters) { %>
  <div class="alert alert-info alert-dismissible fade show" role="alert" style="border-left: 4px solid #0d6efd;">
    <i class="fas fa-filter me-2"></i><strong>Filtres actifs:</strong>
    <% if (filters.classe) { %>
      <span class="badge bg-primary me-2"><%= filters.classe %></span>
    <% } %>
    <% if (filters.telephone_parent) { %>
      <span class="badge bg-primary"><%= filters.telephone_parent %></span>
    <% } %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
  </div>
<% } %>

<!-- Section d'affichage des filtres à l'impression (pour cohérence avec l'écran) -->
<div class="p-3 print-only" id="printFiltersInfo" style="border: 1px solid #666; border-radius: 4px; background-color: #f8f9fa; margin-bottom: 1rem;">
  <h6 class="mb-2"><i class="fas fa-filter me-2"></i>Filtres appliqués</h6>
  <p class="mb-0" id="printFiltersText">Aucun filtre appliqué</p>
</div>

<div class="card card-modern fade-in compact-body">
  <div class="card-header print-header print-only">
    <h4>Liste des Étudiants</h4>
    <p style="margin: 0; font-size: 10pt; color: #666;">
      Généré le <%= new Date().toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
    </p>
  </div>
  <div class="card-body">
    <div class="table-responsive table-modern table-compact">
      <table id="table-etudiants" class="table table-hover align-middle mb-0 print-table">
        <thead>
          <tr>
            <th style="width: 12%;">Matricule</th>
            <th style="width: 15%;">Nom</th>
            <th style="width: 15%;">Prénom</th>
            <th style="width: 13%;">Date Naissance</th>
            <th style="width: 13%;">Lieu Naissance</th>
            <th style="width: 10%;">Classe</th>
            <th style="width: 13%;">Téléphone Parent</th>
            <th style="width: 8%;">Vacciné</th>
            <th class="no-print" style="width: 5%;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% (etudiants || []).forEach(function(e){ %>
            <tr>
              <td><span class="badge bg-light text-dark" style="border: 1px solid #333;"><%= e.numero_matricule %></span></td>
              <td><% if (e.nom) { %><%= e.nom %><% } else { %><span class="text-muted">-</span><% } %></td>
              <td><%= e.prenom %></td>
              <td>
                <% if (e.date_naissance) { %>
                  <span class="print-date"><%= new Date(e.date_naissance).toLocaleDateString('fr-FR') %></span>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
              <td>
                <% if (e.lieu_naissance) { %>
                  <span class="print-text"><%= e.lieu_naissance %></span>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
              <td><span style="border: 1px solid #999; padding: 2px 4px;"><%= e.classe %></span></td>
              <td><span class="print-phone"><%= e.telephone_parent %></span></td>
              <td>
                <% if (e.est_vaccine) { %>
                  <span class="badge bg-success" style="border: 1px solid #000;">✓</span>
                <% } else { %>
                  <span class="badge bg-secondary" style="border: 1px solid #000;">✗</span>
                <% } %>
              </td>
              <td class="no-print">
                <div class="btn-group">
                  <a href="/etudiants/edit/<%= e._id %>" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="Modifier"><i class="fas fa-edit"></i></a>
                  <a href="/etudiants/delete/<%= e._id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Supprimer ?')" data-bs-toggle="tooltip" title="Supprimer"><i class="fas fa-trash"></i></a>
                  <a href="/paiements" class="btn btn-sm btn-outline-success" data-bs-toggle="tooltip" title="Paiements"><i class="fas fa-receipt"></i></a>
                  <a href="/notes" class="btn btn-sm btn-outline-warning" data-bs-toggle="tooltip" title="Notes"><i class="fas fa-clipboard-list"></i></a>
                  <a href="/bulletin?matricule=<%= e.numero_matricule %>" class="btn btn-sm btn-outline-info" data-bs-toggle="tooltip" title="Bulletin"><i class="fas fa-file-pdf"></i></a>
                  <a href="/certificat?matricule=<%= e.numero_matricule %>" class="btn btn-sm btn-outline-secondary" data-bs-toggle="tooltip" title="Certificat"><i class="fas fa-certificate"></i></a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  // Initialisation recherche/tri sur le tableau
  (function(){
    try {
      window.AppTables?.initTable('table-etudiants', { searchable: true, sortable: true });
    } catch (e) { console.warn('Init table', e); }

    // Recherche en temps réel via l'input
    const search = document.getElementById('search-etudiants');
    const table = document.getElementById('table-etudiants');
    if (search && table && window.AppTables) {
      search.addEventListener('input', window.AppUtils?.debounce(function(){
        window.AppTables.filterTableRows(table, search.value);
      }, 300));
    }
  })();

  // Fonction pour mettre à jour les filtres affichés à l'impression
  function updatePrintFiltersInfo() {
    const classe = document.getElementById('classe').value;
    const telephone = document.getElementById('telephone_parent').value;
    const printFiltersText = document.getElementById('printFiltersText');
    
    let filtersApplied = [];
    if (classe) filtersApplied.push(`Classe: <strong>${classe}</strong>`);
    if (telephone) filtersApplied.push(`Téléphone parent: <strong>${telephone}</strong>`);
    
    if (filtersApplied.length > 0) {
      printFiltersText.innerHTML = filtersApplied.join(' | ');
    } else {
      printFiltersText.innerHTML = 'Aucun filtre appliqué';
    }
  }

  // Mettre à jour les filtres au chargement et lors des changements de filtre
  updatePrintFiltersInfo();
  document.getElementById('classe').addEventListener('change', updatePrintFiltersInfo);
  document.getElementById('telephone_parent').addEventListener('input', updatePrintFiltersInfo);
</script>

<%- include('partials/footer') %>

<script>
// Écouter les changements d'année scolaire déclenchés par la transition
window.addEventListener('storage', function(event) {
  if (!event) return;
  if (event.key === 'annee_scolaire_changed_at') {
    console.info('Année scolaire modifiée dans un autre onglet — rechargement de la liste des étudiants');
    // Recharger la page pour actualiser la liste des étudiants
    location.reload();
  }
});
</script>
