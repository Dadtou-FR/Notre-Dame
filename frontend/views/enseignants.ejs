<%- include('partials/header', { title: 'Gestion des enseignants' }) %>

<!-- Success Messages -->
<% if (success && success !== '') { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="fas fa-check-circle me-2"></i>
    <% if (success === 'created') { %>
      Enseignant ajouté avec succès !
    <% } else if (success === 'updated') { %>
      Enseignant mis à jour avec succès !
    <% } else if (success === 'deleted') { %>
      Enseignant supprimé avec succès !
    <% } else { %>
      Donnée ajoutée avec succès !
    <% } %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
  </div>
<% } %>

<!-- En-tête avec titre et bouton d'ajout -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1 text-gradient">Enseignants</h1>
    <p class="text-muted mb-0">Gérez les enseignants de l'établissement</p>
  </div>
  <div>
    <a href="/enseignants/add" class="btn btn-primary btn-modern">
      <i class="fas fa-plus me-2"></i>Ajouter un enseignant
    </a>
  </div>
</div>

<!-- Barre de recherche et filtres -->
<div class="card card-modern mb-4 fade-in">
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-6">
        <div class="input-group">
          <span class="input-group-text"><i class="fas fa-search"></i></span>
          <input type="text" class="form-control" id="searchInput" placeholder="Rechercher un enseignant...">
        </div>
      </div>
      <div class="col-md-3 d-flex align-items-center gap-2">
        <select class="form-select" id="filterMatiere">
          <option value="">Toutes les matières</option>
          <option value="Catéchèse">Catéchèse</option>
          <option value="Philosophie / Initiation">Philosophie / Initiation</option>
          <option value="Malagasy">Malagasy</option>
          <option value="Français">Français</option>
          <option value="Anglais">Anglais</option>
          <option value="Espagnol">Espagnol</option>
          <option value="Histoire - Géographie">Histoire - Géographie</option>
          <option value="Mathématiques">Mathématiques</option>
          <option value="Physique - Chimie">Physique - Chimie</option>
          <option value="SVT">SVT</option>
          <option value="Informatique">Informatique</option>
          <option value="EPS">EPS</option>
        </select>
        <button type="button" class="btn btn-outline-secondary btn-modern no-print" onclick="window.print()" title="Imprimer la liste filtrée">
          <i class="fas fa-print me-1"></i>Imprimer
        </button>
      </div>
      <div class="col-md-3">
        <button class="btn btn-outline-secondary btn-modern w-100" onclick="clearFilters()">
          <i class="fas fa-times me-2"></i>Effacer les filtres
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Tableau des enseignants -->
<div class="card card-modern fade-in">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">
      <i class="fas fa-chalkboard-teacher me-2"></i>Liste des enseignants
    </h5>
    <span class="badge bg-primary" id="teacherCount"><%= enseignants.length %> enseignant(s)</span>
  </div>
  <div class="p-2 print-only" id="printFilters"></div>
  <div class="print-header print-only">
    <h4>Liste des Enseignants</h4>
    <p style="margin: 0; font-size: 10pt; color: #666;">
      Généré le <%= new Date().toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
    </p>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-modern mb-0 print-table" id="teachersTable">
        <thead>
          <tr>
            <th style="width: 20%;"><span class="no-print">👤 </span>Nom complet</th>
            <th style="width: 15%;"><span class="no-print">📚 </span>Matière</th>
            <th style="width: 20%;"><span class="no-print">🏫 </span>Classes</th>
            <th style="width: 10%; display: none;"><span class="no-print">📊 </span>Niveaux</th>
            <th style="width: 15%;"><span class="no-print">📞 </span>Téléphone</th>
            <th style="width: 15%;"><span class="no-print">✉️ </span>Email</th>
            <th style="width: 8%; display: none;"><span class="no-print">📅 </span>Date d'embauche</th>
            <th style="width: 2%; text-align: center;" class="no-print"><span class="no-print">⚙️ </span>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (enseignants.length === 0) { %>
            <tr>
              <td colspan="10" class="text-center py-5">
                <div class="text-muted">
                  <i class="fas fa-user-slash fa-3x mb-3 d-block"></i>
                  <h5>Aucun enseignant enregistré</h5>
                  <p>Commencez par ajouter votre premier enseignant</p>
                  <a href="/enseignants/add" class="btn btn-primary btn-modern">
                    <i class="fas fa-plus me-2"></i>Ajouter un enseignant
                  </a>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% enseignants.forEach(function(e){ %>
              <tr>
                <td>
                  <div><strong><%= e.prenom %> <%= e.nom %></strong></div>
                  <small class="text-muted no-print" style="display: inline-block;">ID: <%= e._id.toString().substring(0, 8) %>...</small>
                </td>
                <td>
                  <span class="badge bg-info" style="border: 1px solid #000; padding: 3px 5px;"><%= e.matiere %></span>
                </td>
                <td>
                  <% if (e.classes && e.classes.length > 0) { %>
                    <% e.classes.forEach(function(classe) { %>
                      <span class="badge bg-success" style="border: 1px solid #000; padding: 2px 4px; margin-right: 2px; display: inline-block;"><%= classe %></span>
                    <% }) %>
                  <% } else { %>
                    <span class="text-muted">Aucune classe</span>
                  <% } %>
                </td>
                <td style="display: none;">
                  <% if (e.classes && e.classes.length > 0) { %>
                    <% const niveaux = [...new Set(e.classes.map(c => c.split(' ')[0]))]; %>
                    <% niveaux.forEach(function(niveau) { %>
                      <span class="badge bg-warning" style="border: 1px solid #000; padding: 2px 4px; margin-right: 2px;"><%= niveau %></span>
                    <% }) %>
                  <% } else { %>
                    <span class="text-muted">Aucun niveau</span>
                  <% } %>
                </td>
                <td>
                  <span class="print-phone"><%= e.telephone %></span>
                </td>
                <td>
                  <% if (e.email) { %>
                    <span class="print-email" style="word-break: break-word;"><%= e.email %></span>
                  <% } else { %>
                    <span class="text-muted">Non renseigné</span>
                  <% } %>
                </td>
                <td style="display: none;">
                  <% if (e.date_embauche) { %>
                    <span class="print-date"><%= new Date(e.date_embauche).toLocaleDateString('fr-FR') %></span>
                  <% } else { %>
                    <span class="text-muted">Non renseignée</span>
                  <% } %>
                </td>
                <td class="text-center no-print">
                  <div class="btn-group" role="group">
                    <button class="btn btn-outline-primary btn-sm" onclick="editTeacher('<%= e._id %>')" title="Modifier">
                      <i class="fas fa-edit"></i>
                    </button>
                    <button class="btn btn-outline-info btn-sm" onclick="viewTeacher('<%= e._id %>')" title="Voir détails">
                      <i class="fas fa-eye"></i>
                    </button>
                    <button class="btn btn-outline-danger btn-sm" onclick="deleteTeacher('<%= e._id %>', '<%= e.prenom %> <%= e.nom %>')" title="Supprimer">
                      <i class="fas fa-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Scripts pour la fonctionnalité -->
<script>
// Fonction de recherche
document.getElementById('searchInput').addEventListener('input', function() {
  const searchTerm = this.value.toLowerCase();
  const rows = document.querySelectorAll('#teachersTable tbody tr');
  
  rows.forEach(row => {
    const text = row.textContent.toLowerCase();
    row.style.display = text.includes(searchTerm) ? '' : 'none';
  });
  
  updateTeacherCount();
  updatePrintFilters();
});

// Fonction de filtrage par matière
document.getElementById('filterMatiere').addEventListener('change', function() {
  const filterValue = this.value;
  const rows = document.querySelectorAll('#teachersTable tbody tr');
  
  rows.forEach(row => {
    if (filterValue === '') {
      row.style.display = '';
    } else {
      const matiereCell = row.cells[1];
      const matiere = matiereCell.textContent.trim();
      row.style.display = matiere.includes(filterValue) ? '' : 'none';
    }
  });
  
  updateTeacherCount();
  updatePrintFilters();
});

// Fonction pour effacer les filtres
function clearFilters() {
  document.getElementById('searchInput').value = '';
  document.getElementById('filterMatiere').value = '';
  
  const rows = document.querySelectorAll('#teachersTable tbody tr');
  rows.forEach(row => {
    row.style.display = '';
  });
  
  updateTeacherCount();
  updatePrintFilters();
}

// Fonction pour mettre à jour le compteur
function updateTeacherCount() {
  const visibleRows = document.querySelectorAll('#teachersTable tbody tr[style=""], #teachersTable tbody tr:not([style])');
  document.getElementById('teacherCount').textContent = visibleRows.length + ' enseignant(s)';
}

// Met à jour le résumé des filtres pour l'impression
function updatePrintFilters() {
  const searchTerm = document.getElementById('searchInput').value;
  const mat = document.getElementById('filterMatiere').value;
  let text = '';
  
  let filtersApplied = [];
  if (searchTerm) filtersApplied.push(`Recherche: <strong>${searchTerm}</strong>`);
  if (mat) filtersApplied.push(`Matière: <strong>${mat}</strong>`);
  
  if (filtersApplied.length > 0) {
    text = 'Filtres appliqués: ' + filtersApplied.join(' | ');
  } else {
    text = 'Aucun filtre appliqué';
  }
  
  document.getElementById('printFilters').innerHTML = text;
}

// initial print filters message
updatePrintFilters();

// Fonction pour modifier un enseignant
function editTeacher(id) {
  window.location.href = '/enseignants/edit/' + id;
}

// Fonction pour voir les détails
function viewTeacher(id) {
  window.location.href = '/enseignants/view/' + id;
}

// Fonction pour supprimer un enseignant
function deleteTeacher(id, name) {
  if (confirm(`Êtes-vous sûr de vouloir supprimer l'enseignant "${name}" ?\n\nCette action est irréversible.`)) {
    window.location.href = '/enseignants/delete/' + id;
  }
}
</script>

<%- include('partials/footer') %>
