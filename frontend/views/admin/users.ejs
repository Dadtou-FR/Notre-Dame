<%- include('../partials/header', { title: 'Gestion des utilisateurs' }) %>

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestion des utilisateurs</h2>
    <a href="/admin/users/add" class="btn btn-primary">
      <i class="bi bi-plus-circle"></i> Nouveau utilisateur
    </a>
  </div>

  <% if (successMessage) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= successMessage %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <% if (errorMessage) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= errorMessage %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="card shadow">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover table-striped">
          <thead class="table-dark">
            <tr>
              <th>Nom d'utilisateur</th>
              <th>Rôle</th>
              <th>Nom</th>
              <th>Prénom</th>
              <th>Email</th>
              <th>Statut</th>
              <th>Dernière connexion</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && users.length > 0) { %>
              <% users.forEach(user => { %>
                <tr>
                  <td><strong><%= user.username %></strong></td>
                  <td>
                    <% const roleLabels = { 
                      'admin': '<span class="badge bg-danger">Administrateur</span>',
                      'secretaire': '<span class="badge bg-primary">Secrétaire</span>',
                      'caissiere': '<span class="badge bg-success">Caissière</span>',
                      'enseignant': '<span class="badge bg-info">Enseignant</span>'
                    }; %>
                    <%- roleLabels[user.role] || user.role %>
                  </td>
                  <td>
                    <% 
                      const genericRoles = ['admin', 'secretaire', 'caissiere', 'enseignant'];
                      if (genericRoles.includes(user.role)) { %>
                        -
                      <% } else { %>
                        <%= user.nom || '-' %>
                      <% } %>
                  </td>
                  <td>
                    <% 
                      const genericRoles2 = ['admin', 'secretaire', 'caissiere', 'enseignant'];
                      if (genericRoles2.includes(user.role)) { %>
                        -
                      <% } else { %>
                        <%= user.prenom || '-' %>
                      <% } %>
                  </td>
                  <td><%= user.email || '-' %></td>
                  <td>
                    <% if (user.active) { %>
                      <span class="badge bg-success">Actif</span>
                    <% } else { %>
                      <span class="badge bg-secondary">Inactif</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (user.lastLogin) { %>
                      <%= new Date(user.lastLogin).toLocaleDateString('fr-FR') %>
                    <% } else { %>
                      <span class="text-muted">Jamais</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="btn-group" role="group">
                      <a href="/admin/users/edit/<%= user._id %>" class="btn btn-sm btn-primary" title="Modifier">
                        <i class="bi bi-pencil-square"></i> Modifier
                      </a>
                      <% if (user.active) { %>
                        <form method="POST" action="/admin/users/toggle/<%= user._id %>" style="display: inline;">
                          <button type="submit" class="btn btn-sm btn-secondary" title="Désactiver">
                            <i class="bi bi-person-dash"></i>
                          </button>
                        </form>
                      <% } else { %>
                        <form method="POST" action="/admin/users/toggle/<%= user._id %>" style="display: inline;">
                          <button type="submit" class="btn btn-sm btn-success" title="Activer">
                            <i class="bi bi-person-check"></i>
                          </button>
                        </form>
                      <% } %>
                      <form method="POST" action="/admin/users/delete/<%= user._id %>" style="display: inline;" 
                            onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');">
                        <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center text-muted py-4">
                  <i class="bi bi-people"></i> Aucun utilisateur trouvé
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="mt-3">
    <a href="/" class="btn btn-secondary">
      <i class="bi bi-arrow-left"></i> Retour au tableau de bord
    </a>
  </div>
</div>

<%- include('../partials/footer') %>
